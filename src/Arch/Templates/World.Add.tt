<#@ template language="C#" #>
<#@ output extension=".cs" #>
<#@ import namespace="System.Text" #>
<#@ include file="Helpers.ttinclude" #>

using System;
using System.Runtime.CompilerServices;
using CommunityToolkit.HighPerformance;
using Arch.Core.Utils;

namespace Arch.Core;
public partial class World
{
    <#
    for (var index = 2; index <= Amount; index++)
    {
        var generics = AppendGenerics(index);
        var parameters = AppendGenericInDefaultParams(index);
        var inParameters = InsertGenericInParams(index);

        var addEvents = new StringBuilder();
        for (var i = 0; i < index; i++)
        {
            addEvents.AppendLine($"OnComponentAdded<T{i}>(entity);");
        }
    #>

    [SkipLocalsInit]
    [StructuralChange]
    public void Add<<#= generics #>>(Entity entity, <#= parameters #>)
    {
        ref var data = ref EntityInfo.EntityData[entity.Id];
        var oldArchetype = data.Archetype;

        var transition = GetOrCreateAddTransition(Component<<#= generics #>>.Signature, oldArchetype);
        var newArchetype = transition.Target;

        Move(entity, ref data, oldArchetype, newArchetype, out var newSlot, transition);
        newArchetype.Set<<#= generics #>>(ref newSlot, <#= inParameters #>);
        <#= Indent(addEvents, 8) #>
    }
    <#
    }
    #>
}
